{
    "id": "org.gnome.gitlab.TitouanReal.Era",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "era",
    "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
    "finish-args": [
        "--share=ipc",
        "--device=dri",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--system-talk-name=org.freedesktop.timedate1",
        "--talk-name=org.gnome.evolution.dataserver.Sources5",
        "--talk-name=org.gnome.evolution.dataserver.Calendar8"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "RUST_BACKTRACE": "1",
            "RUST_LOG": "era=debug"
        }
    },
    "modules": [
        {
            "name": "grass",
            "buildsystem": "simple",
            "build-options": {
                "env": {
                    "CARGO_HOME": "/run/build/grass/cargo"
                }
            },
            "build-commands": [
                "cargo build --release --locked",
                "mkdir -p /app/bin",
                "install -D ./target/release/grass /app/bin/"
            ],
            "cleanup": ["*"],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/connorskees/grass",
                    "tag": "0.13.4",
                    "commit": "e0bb9e2eabfc3a58e42b03089cd7b22c68d09d0b"
                },
                "grass-cargo-sources.json"
            ]
        },
        {
            "name": "meson",
            "buildsystem": "simple",
            "build-commands": ["python3 setup.py install --prefix=/app"],
            "cleanup": ["*"],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/TitouanReal/meson",
                    "commit": "fb91681687e0f17174f1afdffbb170d54964ccf5"
                }
            ]
        },
        {
            "name": "libical",
            "cleanup": ["/lib/cmake"],
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_INSTALL_LIBDIR:PATH=/app/lib",
                "-DBUILD_SHARED_LIBS=On",
                "-DICAL_BUILD_DOCS=False",
                "-DWITH_CXX_BINDINGS=False"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libical/libical/releases/download/v3.0.20/libical-3.0.20.tar.gz",
                    "sha256": "e73de92f5a6ce84c1b00306446b290a2b08cdf0a80988eca0a2c9d5c3510b4c2"
                }
            ]
        },
        {
            "name": "evolution-data-server",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DENABLE_CANBERRA=OFF",
                "-DENABLE_GOA=OFF",
                "-DENABLE_DOT_LOCKING=OFF",
                "-DENABLE_FILE_LOCKING=fcntl",
                "-DENABLE_GTK=OFF",
                "-DENABLE_GTK4=ON",
                "-DENABLE_GOOGLE=OFF",
                "-DENABLE_VALA_BINDINGS=OFF",
                "-DENABLE_WEATHER=OFF",
                "-DWITH_OPENLDAP=OFF",
                "-DWITH_LIBDB=OFF",
                "-DENABLE_INTROSPECTION=OFF",
                "-DENABLE_INSTALLED_TESTS=OFF",
                "-DENABLE_GTK_DOC=OFF",
                "-DENABLE_EXAMPLES=OFF",
                "-DENABLE_OAUTH2_WEBKITGTK4=OFF"
            ],
            "cleanup": ["/share/GConf"],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/GNOME/evolution-data-server.git",
                    "commit": "99edc087f1207979d951295f1a01f9b010e176ca"
                }
            ]
        },
        {
            "name": "libclepsydre",
            "buildsystem": "meson",
            "config-opts": ["-Dlibclepsydre=true", "-Dintrospection=true"],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://gitlab.gnome.org/TitouanReal/clepsydre/-/package_files/6284/download",
                    "sha256": "64fe2068d694167a739810a0afe0e0a1442a30337ff3b42cb52201f5bc8391b3",
                    "dest-filename": "libclepsydre.tar.xz"
                }
            ]
        },
        {
            "name": "libclepsydre-eds",
            "buildsystem": "meson",
            "config-opts": ["-Dlibclepsydre-eds=true", "-Dintrospection=true"],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://gitlab.gnome.org/TitouanReal/clepsydre/-/package_files/6285/download",
                    "sha256": "213bb3a64aff685676ff380432cc0f46afc7f26f1700c18dda7ee52f8cb80a10",
                    "dest-filename": "libclepsydre-eds.tar.xz"
                }
            ]
        },
        {
            "name": "era",
            "buildsystem": "meson",
            "config-opts": ["-Dcalendar-backend=flatpak-release-set", "-Dplatform=flatpak", "-Drelease-type=stable"],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://gitlab.gnome.org/TitouanReal/era/-/package_files/6289/download",
                    "sha256": "4866d9f166768af446d87a7a8ae31d67a7ca49b684d0a631e2940ef2343a5d16",
                    "dest-filename": "era.tar.xz"
                }
            ]
        }
    ]
}
